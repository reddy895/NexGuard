# NexGuard Environment Variables Configuration Template

# WhatsApp Local Configuration
# Recipient phone number with country code (e.g. 919876543210 or 15551234567)
WHATSAPP_RECIPIENT=919591152862

# Alert Cooldown in seconds (default: 300 = 5 minutes)
ALERT_COOLDOWN_SECONDS=300

# YOLO Model Configuration
YOLO_MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Accident Rule Engine Parameters
PROXIMITY_THRESHOLD_PX=65.0
VELOCITY_APPROACH_THRESHOLD=8.0
MIN_TEMPORAL_FRAMES=3
POST_COLLISION_STOP_FRAMES=5
