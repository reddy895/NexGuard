# ============================================================
# NexGuard — Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.
# ============================================================

# --- Device ---
# Options: 'cuda', 'cpu', 'mps'
NEXGUARD_DEVICE=cpu

# --- Model ---
NEXGUARD_MODEL_PATH=yolov8n.pt
NEXGUARD_CONFIDENCE=0.40
NEXGUARD_IOU_THRESHOLD=0.45

# --- Video Source ---
# 0 = default webcam, path to file, or rtsp://...
NEXGUARD_SOURCE=0

# --- Detection ---
NEXGUARD_INFERENCE_SIZE=640
NEXGUARD_MAX_FPS=30

# --- Accident Detection ---
# Number of frames to analyze for accident confirmation
NEXGUARD_ACCIDENT_WINDOW=20
# Minimum confirmation score (0.0 - 1.0) to trigger accident
NEXGUARD_ACCIDENT_THRESHOLD=0.60
# Minimum consecutive confirmations before declaring accident
NEXGUARD_ACCIDENT_CONFIRM_FRAMES=5

# --- Severity Thresholds ---
NEXGUARD_SEVERITY_LOW=0.30
NEXGUARD_SEVERITY_MEDIUM=0.55
NEXGUARD_SEVERITY_HIGH=0.75
NEXGUARD_SEVERITY_CRITICAL=0.90

# --- Tracking ---
NEXGUARD_MAX_LOST_FRAMES=30
NEXGUARD_TRACK_HISTORY=30

# --- Alert Cooldown (seconds) ---
NEXGUARD_ALERT_COOLDOWN=60

# --- Evidence ---
NEXGUARD_EVIDENCE_DIR=evidence/incidents
NEXGUARD_EVIDENCE_RETENTION_DAYS=30

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
NEXGUARD_LOG_LEVEL=INFO

# --- WhatsApp Alerts (QR code login — no API key required) ---
# WhatsApp uses whatsapp-web.js with QR code authentication.
# On first run, a QR code appears in the terminal — scan it with WhatsApp.
# Session is saved locally so you only scan once.
NEXGUARD_WHATSAPP_ENABLED=true
# Target phone number(s) with country code, no + or spaces
# Default sends to 9591152862 — change as needed
NEXGUARD_WHATSAPP_RECIPIENTS=9591152862

# --- Alert Routing ---
# Contacts for different severity levels (comma-separated numbers)
NEXGUARD_ALERT_LOW_CONTACTS=
NEXGUARD_ALERT_MEDIUM_CONTACTS=
NEXGUARD_ALERT_HIGH_CONTACTS=
NEXGUARD_ALERT_CRITICAL_CONTACTS=

# --- Location (optional, for alert messages) ---
NEXGUARD_LOCATION_NAME=Unknown Location
